{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "typeorm-ts-node-commonjs migration:generate -d ../../apps/gateway-api/src/database/postgres-data-source.ts",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d ../../apps/gateway-api/src/database/postgres-data-source.ts",
    "db:rollback": "typeorm-ts-node-commonjs migration:revert -d ../../apps/gateway-api/src/database/postgres-data-source.ts",
    "db:show": "typeorm-ts-node-commonjs migration:show -d ../../apps/gateway-api/src/database/postgres-data-source.ts"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"

  }
}
