.DS_Store
.AppleDouble
.LSOverride

node_modules/

# Build output and caches
.next/
dist/
coverage/
out/
*.tsbuildinfo
.turbo/
.pnpm-store/

# tsc emitted in place next to sources (accidental outDir-less builds)
*.js.map
*.d.ts.map
apps/gateway-api/src/**/*.js
apps/gateway-api/src/**/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
services/*/src/**/*.js
services/*/src/**/*.d.ts

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.development.example

# Local databases and runtime files
*.sqlite
*.sqlite-journal
*.db
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
playwright-report/
test-results/
blob-report/

# Local editor configuration
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
