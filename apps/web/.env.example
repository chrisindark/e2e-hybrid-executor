NEXT_PUBLIC_API_URL=http://localhost:8000
# Must be a UUID: the gateway validates the tenant claim as a Postgres uuid and
# the RLS policies compare it against uuid columns. A slug like "tenant-demo"
# makes every authenticated request fail with 500 (invalid input syntax for uuid).
NEXT_PUBLIC_TENANT_ID=0f8fad5b-d9cb-469f-a165-70867728950e
NEXT_PUBLIC_ACTOR_ID=demo-user
