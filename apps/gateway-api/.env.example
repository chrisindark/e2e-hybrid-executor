NODE_ENV=development
APP_NAME=gateway-api
APP_PORT=8000
APP_ADDRESS=0.0.0.0
# HS256 secret shared by the token issuer (/v1/auth/token) and JwtAuthGuard.
# Use a long random value; rotating it invalidates all issued tokens.
JWT_SECRET=change-me-dev-secret
JWT_TOKEN=
DATABASE_PATH=database.sqlite
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379

CORS_ORIGIN_WHITELIST=
CORS_ALLOW_METHODS=

OPENAI_API_KEY=
OPENAI_API_URL=

GROQ_API_KEY=
GROQ_API_URL=

GEMINI_API_KEY=
