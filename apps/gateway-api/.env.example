NODE_ENV=development
APP_NAME=gateway-api
APP_PORT=3001
APP_ADDRESS=0.0.0.0
# HS256 secret shared by the token issuer (/v1/auth/token) and JwtAuthGuard.
# Use a long random value; rotating it invalidates all issued tokens.
JWT_SECRET=change-me-dev-secret
JWT_TOKEN=
# Migrations run as the owning role (creates/alters schema).
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
# Runtime traffic connects as a NON-SUPERUSER role so RLS is enforced.
# Falling back to DATABASE_URL disables RLS if that role is a superuser.
DATABASE_APP_URL=postgresql://app_runtime:app_runtime@localhost:5432/orchestrator
# Password the tenant-roles migration sets on the app_runtime login.
APP_DB_PASSWORD=app_runtime
REDIS_URL=redis://localhost:6379

CORS_ORIGIN_WHITELIST=
CORS_ALLOW_METHODS=

OPENAI_API_KEY=
OPENAI_API_URL=

GROQ_API_KEY=
GROQ_API_URL=

GEMINI_API_KEY=
